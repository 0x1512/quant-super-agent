{
  "type": "object",
  "required": [
    "schema",
    "review_id",
    "exp_id",
    "side",
    "round",
    "reviewer",
    "claims",
    "created_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["review"]
    },
    "review_id": {
      "type": "string",
      "pattern": "^R-[0-9]{3,}$"
    },
    "exp_id": {
      "type": "string",
      "pattern": "^E-[0-9]{3,}$"
    },
    "side": {
      "type": "string",
      "enum": ["bull", "bear"]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "reviewer": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
    }
  }
}
