{
  "type": "object",
  "required": [
    "schema",
    "hyp_id",
    "mechanism",
    "falsifiable_condition",
    "admission",
    "window",
    "ttl_days",
    "status",
    "created_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["hypothesis"]
    },
    "hyp_id": {
      "type": "string",
      "pattern": "^H-[0-9]{3,}$"
    },
    "mechanism": {
      "type": "string"
    },
    "falsifiable_condition": {
      "type": "string"
    },
    "admission": {
      "type": "object",
      "required": ["required_metrics", "thresholds"],
      "properties": {
        "required_metrics": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "thresholds": {
          "type": "object"
        },
        "min_observations": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "window": {
      "type": "string",
      "pattern": "^[0-9]{8}:[0-9]{8}$"
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "status": {
      "type": "string",
      "enum": ["registered", "admitted", "falsified", "supported", "archived"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
    }
  }
}
